# Copie ce fichier en .env.local et remplis les valeurs (Supabase → Project Settings → API).
# Clé publique uniquement (anon / publishable) : jamais la clé service_role / sb_secret_ ici.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Source des projets : supabase (défaut) ou local (fichiers de src/content/projects/)
VITE_PROJECTS_SOURCE=supabase
